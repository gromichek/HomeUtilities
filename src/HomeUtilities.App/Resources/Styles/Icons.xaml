<?xml version="1.0" encoding="UTF-8" ?>
<!--
    One resource per icon of docs/UI_GUIDELINES.md §1. Android: Material Icons Outlined (bundled static font, ~330 KB, same code points as Material Symbols);
    Windows: Segoe Fluent Icons (Windows 11) with Segoe MDL2 Assets as the Windows 10 fallback (system fonts).
    Pages use only these keys, never raw glyph codes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <OnPlatform x:Key="IconFontFamily" x:TypeArguments="x:String">
        <On Platform="Android" Value="MaterialIcons" />
        <On Platform="WinUI" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    </OnPlatform>

    <!-- Font of every FontImageSource (toolbar icons, menu icons): the font FILE bundled with the app, on all platforms.
         In an unpackaged Windows app MAUI's FontImageSourceService turns the font of an image into a file URI
         (FontImageSourceService.Windows.cs, GetFontSource → new Uri(source).LocalPath); a system font ("Segoe MDL2 Assets"),
         a fallback list or the default font gives a relative URI and throws "This operation is not supported for a relative
         URI" — images stay empty, and on a theme change (AppThemeBinding colour re-renders every image) the app crashed
         (owner, 2026-11-02; MAUI issue 26441 is the same family of unpackaged-font bugs). Labels may keep IconFontFamily. -->
    <x:String x:Key="IconImageFontFamily">MaterialIcons</x:String>

    <!-- Glyphs of the image icons: Material Icons Outlined code points (all present in the bundled font). -->
    <x:String x:Key="ImageGlyphAdd">&#xE145;</x:String>
    <x:String x:Key="ImageGlyphOpenLink">&#xE89E;</x:String>
    <x:String x:Key="ImageGlyphPaid">&#xE2E6;</x:String>
    <x:String x:Key="ImageGlyphHelp">&#xE8FD;</x:String>
    <x:String x:Key="ImageGlyphSave">&#xE5CA;</x:String>
    <x:String x:Key="MenuGlyphOverview">&#xE88A;</x:String>
    <x:String x:Key="MenuGlyphProperties">&#xEA40;</x:String>
    <x:String x:Key="MenuGlyphSuppliers">&#xE8D1;</x:String>
    <x:String x:Key="MenuGlyphReadings">&#xE9E4;</x:String>
    <x:String x:Key="MenuGlyphCharges">&#xE24A;</x:String>
    <x:String x:Key="MenuGlyphBills">&#xEF6E;</x:String>
    <x:String x:Key="MenuGlyphPayments">&#xEA15;</x:String>
    <x:String x:Key="MenuGlyphReports">&#xE26B;</x:String>
    <x:String x:Key="MenuGlyphHelp">&#xE8FD;</x:String>
    <x:String x:Key="MenuGlyphSettings">&#xE8B8;</x:String>

    <OnPlatform x:Key="IconAdd" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE145;" />
        <On Platform="WinUI" Value="&#xE710;" />
    </OnPlatform>
    <OnPlatform x:Key="IconEdit" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE3C9;" />
        <On Platform="WinUI" Value="&#xE70F;" />
    </OnPlatform>
    <OnPlatform x:Key="IconDelete" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE872;" />
        <On Platform="WinUI" Value="&#xE74D;" />
    </OnPlatform>
    <OnPlatform x:Key="IconSave" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE5CA;" />
        <On Platform="WinUI" Value="&#xE73E;" />
    </OnPlatform>
    <OnPlatform x:Key="IconClose" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE5CD;" />
        <On Platform="WinUI" Value="&#xE711;" />
    </OnPlatform>
    <OnPlatform x:Key="IconMore" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE5D4;" />
        <On Platform="WinUI" Value="&#xE712;" />
    </OnPlatform>
    <OnPlatform x:Key="IconOpenLink" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE89E;" />
        <On Platform="WinUI" Value="&#xE8A7;" />
    </OnPlatform>
    <OnPlatform x:Key="IconCopy" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE14D;" />
        <On Platform="WinUI" Value="&#xE8C8;" />
    </OnPlatform>
    <OnPlatform x:Key="IconArchive" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE149;" />
        <On Platform="WinUI" Value="&#xE7B8;" />
    </OnPlatform>
    <OnPlatform x:Key="IconHistory" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE889;" />
        <On Platform="WinUI" Value="&#xE81C;" />
    </OnPlatform>
    <!-- Paid: the "mark as paid" quick action (Material task_alt / Segoe CheckMark). Proposed for the UI guidelines table. -->
    <OnPlatform x:Key="IconPaid" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE2E6;" />
        <On Platform="WinUI" Value="&#xE73E;" />
    </OnPlatform>
    <OnPlatform x:Key="IconPhoto" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE412;" />
        <On Platform="WinUI" Value="&#xE722;" />
    </OnPlatform>
    <!-- Not in the guidelines table yet: expand / collapse chevrons (expand_more / expand_less, ChevronDown / ChevronUp). -->
    <OnPlatform x:Key="IconHelp" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE8FD;" />
        <On Platform="WinUI" Value="&#xE897;" />
    </OnPlatform>
    <OnPlatform x:Key="IconExpand" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE5CF;" />
        <On Platform="WinUI" Value="&#xE70D;" />
    </OnPlatform>
    <OnPlatform x:Key="IconCollapse" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE5CE;" />
        <On Platform="WinUI" Value="&#xE70E;" />
    </OnPlatform>

    <!-- Choice dialog rows (docs/UI_GUIDELINES.md §3a): check_box / check_box_outline_blank / radio_button_checked / radio_button_unchecked;
         Segoe: CheckboxComposite / Checkbox / RadioBtnOn / RadioBtnOff. -->
    <OnPlatform x:Key="IconCheckOn" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE834;" />
        <On Platform="WinUI" Value="&#xE73A;" />
    </OnPlatform>
    <OnPlatform x:Key="IconCheckOff" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE835;" />
        <On Platform="WinUI" Value="&#xE739;" />
    </OnPlatform>
    <OnPlatform x:Key="IconRadioOn" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE837;" />
        <On Platform="WinUI" Value="&#xECCB;" />
    </OnPlatform>
    <OnPlatform x:Key="IconRadioOff" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE836;" />
        <On Platform="WinUI" Value="&#xECCA;" />
    </OnPlatform>

    <!-- Overview to-do rows (proposed for the UI guidelines table): readings = speed / Diagnostic, due bill = event / Calendar,
         missing bill = note_add / Document, verification = build / Warning, settlement = balance / Calculator, chevron = chevron_right. -->
    <OnPlatform x:Key="IconTodoReadings" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE9E4;" />
        <On Platform="WinUI" Value="&#xE9D9;" />
    </OnPlatform>
    <OnPlatform x:Key="IconTodoDue" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE878;" />
        <On Platform="WinUI" Value="&#xE787;" />
    </OnPlatform>
    <OnPlatform x:Key="IconTodoMissing" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE89C;" />
        <On Platform="WinUI" Value="&#xE8A5;" />
    </OnPlatform>
    <OnPlatform x:Key="IconTodoVerification" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE869;" />
        <On Platform="WinUI" Value="&#xE7BA;" />
    </OnPlatform>
    <OnPlatform x:Key="IconTodoSettlement" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xEAF6;" />
        <On Platform="WinUI" Value="&#xE8EF;" />
    </OnPlatform>
    <OnPlatform x:Key="IconChevron" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE5CC;" />
        <On Platform="WinUI" Value="&#xE76C;" />
    </OnPlatform>

    <!-- Settings list rows (T-028d): language / palette / event / backup / category / percent / description / upload_file / bug_report / info; Segoe: Globe / Color / Calendar / Upload / Tag / Calculator / Page / Import / ErrorBadge / Info. -->
    <OnPlatform x:Key="IconSettingsLanguage" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE894;" />
        <On Platform="WinUI" Value="&#xE774;" />
    </OnPlatform>
    <OnPlatform x:Key="IconSettingsTheme" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE40A;" />
        <On Platform="WinUI" Value="&#xE790;" />
    </OnPlatform>
    <OnPlatform x:Key="IconSettingsReminders" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE878;" />
        <On Platform="WinUI" Value="&#xE787;" />
    </OnPlatform>
    <OnPlatform x:Key="IconSettingsBackup" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE864;" />
        <On Platform="WinUI" Value="&#xE898;" />
    </OnPlatform>
    <!-- Sync (T-030): sync (Material, checked in the bundled font) / Sync (Segoe MDL2 E895). -->
    <OnPlatform x:Key="IconSettingsSync" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE627;" />
        <On Platform="WinUI" Value="&#xE895;" />
    </OnPlatform>
    <OnPlatform x:Key="IconSettingsCategories" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE574;" />
        <On Platform="WinUI" Value="&#xE8EC;" />
    </OnPlatform>
    <OnPlatform x:Key="IconSettingsVatRates" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xEB58;" />
        <On Platform="WinUI" Value="&#xE8EF;" />
    </OnPlatform>
    <OnPlatform x:Key="IconSettingsBillTemplates" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE873;" />
        <On Platform="WinUI" Value="&#xE7C3;" />
    </OnPlatform>
    <OnPlatform x:Key="IconSettingsImports" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE9FC;" />
        <On Platform="WinUI" Value="&#xE8B5;" />
    </OnPlatform>
    <OnPlatform x:Key="IconSettingsErrorLog" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE868;" />
        <On Platform="WinUI" Value="&#xE783;" />
    </OnPlatform>
    <OnPlatform x:Key="IconSettingsAbout" x:TypeArguments="x:String">
        <On Platform="Android" Value="&#xE88E;" />
        <On Platform="WinUI" Value="&#xE946;" />
    </OnPlatform>

    <!-- Image sources for toolbar items and buttons with an icon next to the text. -->
    <FontImageSource x:Key="IconAddSource"
                     FontFamily="{StaticResource IconImageFontFamily}"
                     Glyph="{StaticResource ImageGlyphAdd}"
                     Size="20"
                     Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
    <FontImageSource x:Key="IconOpenLinkSource"
                     FontFamily="{StaticResource IconImageFontFamily}"
                     Glyph="{StaticResource ImageGlyphOpenLink}"
                     Size="20"
                     Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
    <FontImageSource x:Key="IconPaidSource"
                     FontFamily="{StaticResource IconImageFontFamily}"
                     Glyph="{StaticResource ImageGlyphPaid}"
                     Size="20"
                     Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
    <FontImageSource x:Key="IconHelpSource"
                     FontFamily="{StaticResource IconImageFontFamily}"
                     Glyph="{StaticResource ImageGlyphHelp}"
                     Size="24"
                     Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
    <FontImageSource x:Key="IconSaveSource"
                     FontFamily="{StaticResource IconImageFontFamily}"
                     Glyph="{StaticResource ImageGlyphSave}"
                     Size="24"
                     Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />

</ResourceDictionary>
