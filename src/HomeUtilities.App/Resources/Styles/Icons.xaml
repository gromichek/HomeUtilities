<?xml version="1.0" encoding="UTF-8" ?>
<!--
    One resource per icon of docs/UI_GUIDELINES.md §1: Google Material Icons Outlined (bundled static font, ~330 KB) on
    BOTH platforms — no Segoe glyphs (R-17), so the same action looks the same everywhere.
    Pages use only these keys, never raw glyph codes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <x:String x:Key="IconFontFamily">MaterialIcons</x:String>

    <!-- Font of every FontImageSource (toolbar icons, menu icons): the font FILE bundled with the app, on all platforms.
         In an unpackaged Windows app MAUI's FontImageSourceService turns the font of an image into a file URI
         (FontImageSourceService.Windows.cs, GetFontSource → new Uri(source).LocalPath); a system font ("Segoe MDL2 Assets"),
         a fallback list or the default font gives a relative URI and throws "This operation is not supported for a relative
         URI" — images stay empty, and on a theme change (AppThemeBinding colour re-renders every image) the app crashed
         (owner, 2026-11-02; MAUI issue 26441 is the same family of unpackaged-font bugs). Labels may keep IconFontFamily. -->
    <x:String x:Key="IconImageFontFamily">MaterialIcons</x:String>

    <!-- Glyphs of the image icons: Material Icons Outlined code points (all present in the bundled font). -->
    <x:String x:Key="ImageGlyphAdd">&#xE145;</x:String>
    <x:String x:Key="ImageGlyphOpenLink">&#xE89E;</x:String>
    <x:String x:Key="ImageGlyphPaid">&#xE2E6;</x:String>
    <x:String x:Key="ImageGlyphHelp">&#xE8FD;</x:String>
    <x:String x:Key="ImageGlyphSave">&#xE5CA;</x:String>
    <x:String x:Key="MenuGlyphOverview">&#xE88A;</x:String>
    <x:String x:Key="MenuGlyphProperties">&#xEA40;</x:String>
    <x:String x:Key="MenuGlyphSuppliers">&#xE8D1;</x:String>
    <x:String x:Key="MenuGlyphReadings">&#xE9E4;</x:String>
    <x:String x:Key="MenuGlyphCharges">&#xE24A;</x:String>
    <x:String x:Key="MenuGlyphBills">&#xEF6E;</x:String>
    <x:String x:Key="MenuGlyphPayments">&#xEA15;</x:String>
    <x:String x:Key="MenuGlyphReports">&#xE26B;</x:String>
    <x:String x:Key="MenuGlyphHelp">&#xE8FD;</x:String>
    <x:String x:Key="MenuGlyphSettings">&#xE8B8;</x:String>

    <x:String x:Key="IconAdd">&#xE145;</x:String>
    <x:String x:Key="IconEdit">&#xE3C9;</x:String>
    <x:String x:Key="IconDelete">&#xE872;</x:String>
    <x:String x:Key="IconSave">&#xE5CA;</x:String>
    <x:String x:Key="IconClose">&#xE5CD;</x:String>
    <x:String x:Key="IconMore">&#xE5D4;</x:String>
    <x:String x:Key="IconOpenLink">&#xE89E;</x:String>
    <x:String x:Key="IconCopy">&#xE14D;</x:String>
    <x:String x:Key="IconArchive">&#xE149;</x:String>
    <x:String x:Key="IconHistory">&#xE889;</x:String>
    <!-- Paid: the "mark as paid" quick action (task_alt, a circled check) — differs from IconSave (check). -->
    <x:String x:Key="IconPaid">&#xE2E6;</x:String>
    <x:String x:Key="IconPhoto">&#xE412;</x:String>
    <x:String x:Key="IconHelp">&#xE8FD;</x:String>
    <x:String x:Key="IconExpand">&#xE5CF;</x:String>
    <x:String x:Key="IconCollapse">&#xE5CE;</x:String>

    <!-- Choice dialog rows (docs/UI_GUIDELINES.md §3a): check_box / check_box_outline_blank / radio_button_checked / radio_button_unchecked;
         Segoe: CheckboxComposite / Checkbox / RadioBtnOn / RadioBtnOff. -->
    <x:String x:Key="IconCheckOn">&#xE834;</x:String>
    <x:String x:Key="IconCheckOff">&#xE835;</x:String>
    <x:String x:Key="IconRadioOn">&#xE837;</x:String>
    <x:String x:Key="IconRadioOff">&#xE836;</x:String>

    <!-- Overview to-do rows (proposed for the UI guidelines table): readings = speed / Diagnostic, due bill = event / Calendar,
         missing bill = note_add / Document, verification = build / Warning, settlement = balance / Calculator, chevron = chevron_right. -->
    <x:String x:Key="IconTodoReadings">&#xE9E4;</x:String>
    <x:String x:Key="IconTodoDue">&#xE878;</x:String>
    <x:String x:Key="IconTodoMissing">&#xE89C;</x:String>
    <x:String x:Key="IconTodoVerification">&#xE869;</x:String>
    <x:String x:Key="IconTodoSettlement">&#xEAF6;</x:String>
    <!-- Back arrow (arrow_back), previous / next period (chevron_left / chevron_right) and the warning mark (warning_amber). -->
    <x:String x:Key="IconBack">&#xE5C4;</x:String>
    <x:String x:Key="IconPrevious">&#xE5CB;</x:String>
    <x:String x:Key="IconNext">&#xE5CC;</x:String>
    <x:String x:Key="IconWarning">&#xF083;</x:String>
    <x:String x:Key="IconChevron">&#xE5CC;</x:String>

    <!-- Settings list rows (T-028d): language / palette / event / backup / category / percent / description / upload_file / bug_report / info; Segoe: Globe / Color / Calendar / Upload / Tag / Calculator / Page / Import / ErrorBadge / Info. -->
    <x:String x:Key="IconSettingsLanguage">&#xE894;</x:String>
    <x:String x:Key="IconSettingsTheme">&#xE40A;</x:String>
    <x:String x:Key="IconSettingsReminders">&#xE878;</x:String>
    <x:String x:Key="IconSettingsBackup">&#xE864;</x:String>
    <!-- Sync (T-030): sync (Material, checked in the bundled font) / Sync (Segoe MDL2 E895). -->
    <x:String x:Key="IconSettingsSync">&#xE627;</x:String>
    <x:String x:Key="IconSettingsCategories">&#xE574;</x:String>
    <x:String x:Key="IconSettingsVatRates">&#xEB58;</x:String>
    <x:String x:Key="IconSettingsBillTemplates">&#xE873;</x:String>
    <x:String x:Key="IconSettingsImports">&#xE9FC;</x:String>
    <x:String x:Key="IconSettingsErrorLog">&#xE868;</x:String>
    <x:String x:Key="IconSettingsAbout">&#xE88E;</x:String>

    <!-- Image sources for toolbar items and buttons with an icon next to the text. -->
    <FontImageSource x:Key="IconAddSource"
                     FontFamily="{StaticResource IconImageFontFamily}"
                     Glyph="{StaticResource ImageGlyphAdd}"
                     Size="20"
                     Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
    <FontImageSource x:Key="IconOpenLinkSource"
                     FontFamily="{StaticResource IconImageFontFamily}"
                     Glyph="{StaticResource ImageGlyphOpenLink}"
                     Size="20"
                     Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
    <FontImageSource x:Key="IconPaidSource"
                     FontFamily="{StaticResource IconImageFontFamily}"
                     Glyph="{StaticResource ImageGlyphPaid}"
                     Size="20"
                     Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />

    <!-- Toolbar items: the toolbar is drawn in the accent colour (AppShell), so its icons use the colour ON the accent
         (OnPrimary), never the accent itself (R-01: 1.6 : 1 before). -->
    <FontImageSource x:Key="IconHelpToolbarSource"
                     FontFamily="{StaticResource IconImageFontFamily}"
                     Glyph="{StaticResource ImageGlyphHelp}"
                     Size="24"
                     Color="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
    <FontImageSource x:Key="IconSaveToolbarSource"
                     FontFamily="{StaticResource IconImageFontFamily}"
                     Glyph="{StaticResource ImageGlyphSave}"
                     Size="24"
                     Color="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />

</ResourceDictionary>
