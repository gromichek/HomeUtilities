<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- On Windows the Windows target comes first so Visual Studio uses it as the default debug framework. -->
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0;net10.0-android</TargetFrameworks>
    <!-- iOS will be added in phase 10: net10.0-ios -->

    <OutputType>Exe</OutputType>
    <RootNamespace>HomeUtilities.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <ApplicationTitle>HomeUtilities</ApplicationTitle>
    <ApplicationId>io.github.gromichek.homeutilities</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(WindowsPackageType)' == 'None'">true</WindowsAppSDKSelfContained>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <!-- Bundles the icon font into the app (Android needs it; Windows uses system icon fonts). -->
    <MauiFont Include="Resources\Fonts\*.otf;Resources\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- The user guide is bundled from docs/user-guide (one source, no copies): guide/en.md, guide/ru.md, guide/img/*.svg. -->
    <MauiAsset Include="..\..\docs\user-guide\**\*" Exclude="..\..\docs\user-guide\**\*.mmd" LogicalName="guide\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeUtilities.Core\HomeUtilities.Core.csproj" />
    <ProjectReference Include="..\HomeUtilities.Data\HomeUtilities.Data.csproj" />
    <ProjectReference Include="..\HomeUtilities.Import\HomeUtilities.Import.csproj" />
    <ProjectReference Include="..\HomeUtilities.ViewModels\HomeUtilities.ViewModels.csproj" />
  </ItemGroup>

</Project>
