<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:conv="clr-namespace:HomeUtilities.App.Converters"
             xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
             x:Class="HomeUtilities.App.Views.MeterLinkEditorView"
             x:DataType="vm:MeterLinkEditorViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">

    <ContentView.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="HasText" />
        <conv:DateOnlyConverter x:Key="DateOnly" />
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">
            <Label Text="{Binding Title}" Style="{StaticResource SectionHeader}" />
            <Label Text="{Binding ContextText}" Style="{StaticResource MutedLabel}" />

            <Label Text="{Binding ValidFromLabel}" Style="{StaticResource MutedLabel}" />
            <DatePicker Date="{Binding ValidFrom, Converter={StaticResource DateOnly}}" />
            <Label Text="{Binding ValidFromError}" Style="{StaticResource ErrorLabel}"
                   IsVisible="{Binding ValidFromError, Converter={StaticResource HasText}}" />
            <Label Text="{Binding WarningText}" Style="{StaticResource WarningLabel}" IsVisible="{Binding HasWarning}" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Switch IsToggled="{Binding HasValidTo}" />
                <Label Grid.Column="1" Text="{Binding HasValidToLabel}" VerticalOptions="Center" />
            </Grid>
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasValidTo}">
                <Label Text="{Binding ValidToLabel}" Style="{StaticResource MutedLabel}" />
                <DatePicker Date="{Binding ValidTo, Converter={StaticResource DateOnly}}" />
                <Label Text="{Binding ValidToError}" Style="{StaticResource ErrorLabel}"
                       IsVisible="{Binding ValidToError, Converter={StaticResource HasText}}" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Margin="0,12,0,0">
                <Button Text="{Binding CancelText}" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Text="{Binding SaveText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
