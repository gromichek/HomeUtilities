<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:HomeUtilities.App.Views"
                xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
                x:Class="HomeUtilities.App.Views.SettingsSectionPage"
                x:DataType="vm:SettingsSectionViewModel"
                Title="{Binding Title}">

    <views:PageBase.ToolbarItems>
        <ToolbarItem Text="{Binding HelpText}" IconImageSource="{StaticResource IconHelpToolbarSource}" Command="{Binding OpenHelpCommand}" />
    </views:PageBase.ToolbarItems>

    <!--
        The settings of one section. Every block is wrapped in a ContentView that carries IsVisible, because the inner layout
        switches its BindingContext to the SettingsViewModel (UI_GUIDELINES §6a). Buttons fill the column and stack vertically,
        so their text wraps instead of being cut (T-028d).
    -->
    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12" MaximumWidthRequest="600" HorizontalOptions="Fill">

            <ContentView IsVisible="{Binding IsLanguage}">
                <VerticalStackLayout Spacing="8" BindingContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
                    <Label Text="{Binding LanguageLabel}" Style="{StaticResource MutedLabel}" />
                    <Picker ItemsSource="{Binding Languages}"
                            ItemDisplayBinding="{Binding DisplayName, x:DataType=vm:LanguageOption}"
                            SelectedItem="{Binding SelectedLanguage}" />
                </VerticalStackLayout>
            </ContentView>

            <ContentView IsVisible="{Binding IsTheme}">
                <VerticalStackLayout Spacing="8" BindingContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
                    <Label Text="{Binding ThemeLabel}" Style="{StaticResource MutedLabel}" />
                    <Picker ItemsSource="{Binding Themes}"
                            ItemDisplayBinding="{Binding DisplayName, x:DataType=vm:ThemeOption}"
                            SelectedItem="{Binding SelectedTheme}" />
                </VerticalStackLayout>
            </ContentView>

            <ContentView IsVisible="{Binding IsReminders}">
                <VerticalStackLayout Spacing="8" BindingContext="{Binding Settings.Reminders}" x:DataType="vm:ReminderSettingsViewModel">
                    <Label Text="{Binding HintText}" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding NotSupportedText}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding IsNotSupported}" />
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding NotificationsBlocked}">
                        <Label Text="{Binding NotificationsBlockedText}" Style="{StaticResource ErrorLabel}" />
                        <Button Text="{Binding OpenNotificationSettingsText}" Command="{Binding OpenNotificationSettingsCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding EnabledLabel}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsEnabled}" VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowDetails}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="{Binding ReadingsLabel}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ReadingsOn}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="{Binding BillsLabel}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding BillsOn}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="{Binding VerificationLabel}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding VerificationOn}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="{Binding DraftsLabel}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding DraftsOn}" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding TimeLabel}" Style="{StaticResource MutedLabel}" />
                        <TimePicker Time="{Binding Time}" Format="HH:mm" HorizontalOptions="Start" />
                        <Label Text="{Binding LeadDaysLabel}" Style="{StaticResource MutedLabel}" />
                        <Stepper Minimum="0" Maximum="14" Increment="1" Value="{Binding LeadDays}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                    <Button Text="{Binding SendTestText}" Command="{Binding SendTestCommand}"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Text="{Binding SendDelayedTestText}" Command="{Binding SendDelayedTestCommand}"
                            IsVisible="{Binding CanSendDelayedTest}" Style="{StaticResource SecondaryButton}" />
                    <Button Text="{Binding PlannedText}" Command="{Binding TogglePlannedCommand}"
                            Style="{StaticResource SecondaryButton}" />
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowPlanned}">
                        <Label Text="{Binding PlannedSummary}" Style="{StaticResource MutedLabel}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Planned}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlannedReminderRowViewModel">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="{Binding Header}" FontAttributes="Bold" />
                                        <Label Text="{Binding Text}" />
                                        <Label Text="{Binding Target}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                        <Label Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Style="{StaticResource ErrorLabel}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ContentView>

            <ContentView IsVisible="{Binding IsBackup}">
                <VerticalStackLayout Spacing="12" BindingContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">

                    <!-- Backup file that the owner keeps outside the app. -->
                    <Border Style="{StaticResource SectionCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding ManualBackupHeader}" Style="{StaticResource SectionHeader}" />
                            <Label Text="{Binding BackupHint}" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding LastBackupText}" />
                            <Button Text="{Binding SaveBackupText}" Command="{Binding SaveBackupCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button Text="{Binding RestoreBackupText}" Command="{Binding RestoreBackupCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Automatic copies on this device (T-029). -->
                    <Border Style="{StaticResource SectionCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding AutoBackupHeader}" Style="{StaticResource SectionHeader}" />
                            <Label Text="{Binding AutoBackupHint}" Style="{StaticResource MutedLabel}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding AutoBackupEnabledLabel}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding AutoBackupEnabled}" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding AutoIntervalLabel}" Style="{StaticResource MutedLabel}" />
                            <Border Padding="12,10" StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChooseIntervalCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding AutoIntervalValue}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{StaticResource IconExpand}" FontFamily="{DynamicResource IconFontFamily}"
                                           VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
                                </Grid>
                            </Border>
                            <Label Text="{Binding AutoKeepLabel}" Style="{StaticResource MutedLabel}" />
                            <Border Padding="12,10" StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChooseKeepCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding AutoKeepValue}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{StaticResource IconExpand}" FontFamily="{DynamicResource IconFontFamily}"
                                           VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
                                </Grid>
                            </Border>
                            <Label Text="{Binding LastAutoBackupText}" />
                            <Label Text="{Binding LastAutoBackupErrorText}" Style="{StaticResource ErrorLabel}"
                                   IsVisible="{Binding HasLastAutoBackupError}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding CopiesHeader}" Style="{StaticResource SectionHeader}" />
                            <Label Text="{Binding CopiesEmptyText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding HasNoCopies}" />
                            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Copies}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AutoBackupRowViewModel">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                                            <Label Text="{Binding Details}" Style="{StaticResource MutedLabel}" />
                                            <Button Text="{Binding RestoreText}" Command="{Binding RestoreCommand}"
                                                    Style="{StaticResource SecondaryButton}" />
                                            <Button Text="{Binding SaveText}" Command="{Binding SaveCommand}"
                                                    Style="{StaticResource SecondaryButton}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Everything as one readable file (JSON). -->
                    <Border Style="{StaticResource SectionCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding DataExportHeader}" Style="{StaticResource SectionHeader}" />
                            <Label Text="{Binding DataExportHint}" Style="{StaticResource MutedLabel}" />
                            <Button Text="{Binding ExportJsonText}" Command="{Binding ExportJsonCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Text="{Binding ImportJsonText}" Command="{Binding ImportJsonCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ContentView>

            <ContentView IsVisible="{Binding IsSync}">
                <VerticalStackLayout Spacing="12" BindingContext="{Binding Settings.Sync}" x:DataType="vm:SyncSettingsViewModel">
                    <Border Style="{StaticResource SectionCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding HintText}" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding ProviderText}" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding StatusText}" FontAttributes="Bold" />
                            <Label Text="{Binding AccountText}" IsVisible="{Binding ShowAccount}" />
                            <Label Text="{Binding MessageText}" IsVisible="{Binding HasMessage}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Style" Value="{StaticResource ErrorLabel}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />
                            <!-- One primary action per state; stacked buttons share the full width (CLAUDE.md UI checklist). -->
                            <Button Text="{Binding ConnectText}" Command="{Binding ConnectCommand}"
                                    IsEnabled="{Binding CanConnect}" IsVisible="{Binding ShowConnect}" Style="{StaticResource PrimaryButton}" />
                            <Button Text="{Binding CancelSignInText}" Command="{Binding CancelSignInCommand}"
                                    IsVisible="{Binding IsConnecting}" Style="{StaticResource SecondaryButton}" />
                            <!-- Data sync (T-031): shown when an account is connected. Switch row = Grid Auto,* with a wrapping label. -->
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowDataSync}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="{Binding SyncSwitchText}" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" IsToggled="{Binding SyncOn}" IsEnabled="{Binding IsNotBusy}" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding SyncRunText}" FontAttributes="Bold" />
                                <Label Text="{Binding LastSyncText}" Style="{StaticResource MutedLabel}" />
                                <Button Text="{Binding ReplaceFromCloudText}" Command="{Binding ReplaceFromCloudCommand}"
                                        IsVisible="{Binding ShowReplaceFromCloud}" Style="{StaticResource PrimaryButton}" />
                                <Button Text="{Binding SyncNowText}" Command="{Binding SyncNowCommand}"
                                        IsVisible="{Binding SyncOn}" Style="{StaticResource PrimaryButton}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="{Binding ShowMessagesText}" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" IsToggled="{Binding ShowMessages}" VerticalOptions="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="{Binding DownloadOnMobileText}" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" IsToggled="{Binding DownloadOnMobile}" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding CloudFilesHeader}" Style="{StaticResource SectionHeader}" />
                                <Button Text="{Binding CloudFilesButtonText}" Command="{Binding LoadCloudFilesCommand}"
                                        Style="{StaticResource SecondaryButton}" />
                                <Label Text="{Binding CloudFilesText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding HasCloudFiles}" />
                                <!-- Details: localized short lines, collapsed until the owner opens them (R-43). -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasDetails}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleDetailsCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0" Text="{Binding DetailsHeader}" Style="{StaticResource SectionHeader}" />
                                    <Label Grid.Column="1" Text="{StaticResource IconExpand}" FontFamily="{DynamicResource IconFontFamily}" FontSize="20"
                                           VerticalOptions="Center" Style="{StaticResource MutedLabel}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" x:DataType="vm:SyncSettingsViewModel" Binding="{Binding DetailsExpanded}" Value="True">
                                                <Setter Property="Text" Value="{StaticResource IconCollapse}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                                <Label Text="{Binding DetailsText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding ShowDetailsList}" />
                            </VerticalStackLayout>
                            <Button Text="{Binding CheckText}" Command="{Binding CheckConnectionCommand}"
                                    IsVisible="{Binding IsSignedIn}" Style="{StaticResource SecondaryButton}" />
                            <Button Text="{Binding DisconnectText}" Command="{Binding DisconnectCommand}"
                                    IsVisible="{Binding CanDisconnect}" Style="{StaticResource DestructiveButton}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ContentView>

            <ContentView IsVisible="{Binding IsErrorLog}">
                <VerticalStackLayout Spacing="8" BindingContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
                    <Label Text="{Binding ErrorLogHint}" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding ErrorLogCountText}" />
                    <Button Text="{Binding CopyLogText}" Command="{Binding CopyLogCommand}"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Text="{Binding ClearLogText}" Command="{Binding ClearLogCommand}"
                            Style="{StaticResource DestructiveButton}" />
                </VerticalStackLayout>
            </ContentView>

            <ContentView IsVisible="{Binding IsAbout}">
                <VerticalStackLayout Spacing="8" BindingContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
                    <Label Text="{Binding VersionText}" />
                    <Label Text="{Binding DatabasePathText}" />
                    <Label Text="{Binding LayoutText}" />
                    <Border Style="{StaticResource SectionCard}" IsVisible="{Binding IsDebugBuild}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding TestDataHeader}" Style="{StaticResource SectionHeader}" />
                            <Button Text="{Binding FillSampleDataText}" Command="{Binding FillSampleDataCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Text="{Binding DeleteAllDataText}" Command="{Binding DeleteAllDataCommand}"
                                    Style="{StaticResource DestructiveButton}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ContentView>

        </VerticalStackLayout>
    </ScrollView>

</views:PageBase>
