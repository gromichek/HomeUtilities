<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:HomeUtilities.App.Views"
             xmlns:conv="clr-namespace:HomeUtilities.App.Converters"
             xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
             x:Class="HomeUtilities.App.Views.ReportPeriodDialogView"
             x:DataType="vm:ReportPeriodDialogViewModel"
             VerticalOptions="Fill"
             BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">

    <ContentView.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="HasText" />
        <conv:DateOnlyConverter x:Key="DateOnly" />
    </ContentView.Resources>

    <!-- Radio rows (presets and "Custom…"); the from / to calendars (month and year only) appear under the rows while "Custom…" is chosen. -->
    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="8">
        <Label Grid.Row="0" Text="{Binding Title}" Style="{StaticResource SectionHeader}" VerticalOptions="Start" />

        <ScrollView Grid.Row="1" VerticalOptions="Start">
            <VerticalStackLayout Spacing="8">
                <views:RadioChoiceList Items="{Binding Presets}" />

                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsCustom}" Padding="4,0">
                    <Label Text="{Binding FromLabel}" Style="{StaticResource MutedLabel}" />
                    <DatePicker x:Name="FromPicker" Format="MMMM yyyy" Date="{Binding FromDate, Converter={StaticResource DateOnly}}" />
                    <Label Text="{Binding ToLabel}" Style="{StaticResource MutedLabel}" />
                    <DatePicker x:Name="ToPicker" Format="MMMM yyyy" Date="{Binding ToDate, Converter={StaticResource DateOnly}}" />
                    <Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}"
                           IsVisible="{Binding Error, Converter={StaticResource HasText}}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="2" Spacing="8" HorizontalOptions="End" Margin="0,12,0,0">
            <Button Text="{Binding CancelText}" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Text="{Binding OkText}" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" />
        </HorizontalStackLayout>
    </Grid>
</ContentView>
