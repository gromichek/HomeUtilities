<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:HomeUtilities.App.Views"
                xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
                x:Class="HomeUtilities.App.Views.SettingsPage"
                x:DataType="vm:SettingsViewModel"
                Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12" MaximumWidthRequest="600" HorizontalOptions="Fill">
            <Label Text="{Binding LanguageLabel}" Style="{StaticResource MutedLabel}" />
            <Picker ItemsSource="{Binding Languages}"
                    ItemDisplayBinding="{Binding DisplayName, x:DataType=vm:LanguageOption}"
                    SelectedItem="{Binding SelectedLanguage}" />

            <Label Text="{Binding ThemeLabel}" Style="{StaticResource MutedLabel}" Margin="0,12,0,0" />
            <Picker ItemsSource="{Binding Themes}"
                    ItemDisplayBinding="{Binding DisplayName, x:DataType=vm:ThemeOption}"
                    SelectedItem="{Binding SelectedTheme}" />

            <Button Text="{Binding CategoriesText}" Command="{Binding OpenCategoriesCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" Margin="0,12,0,0" />

            <Button Text="{Binding VatRatesText}" Command="{Binding OpenVatRatesCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" Margin="0,12,0,0" />

            <Button Text="{Binding BillTemplatesText}" Command="{Binding OpenBillTemplatesCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" Margin="0,12,0,0" />

            <Button Text="{Binding ImportText}" Command="{Binding OpenImportWizardCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" Margin="0,12,0,0" />

            <Button Text="{Binding ImportsText}" Command="{Binding OpenImportsCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" Margin="0,12,0,0" />

            <Border Style="{StaticResource SectionCard}" Margin="0,12,0,0" BindingContext="{Binding Reminders}" x:DataType="vm:ReminderSettingsViewModel">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding HeaderText}" Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding HintText}" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding NotSupportedText}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding IsNotSupported}" />
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding NotificationsBlocked}">
                        <Label Text="{Binding NotificationsBlockedText}" Style="{StaticResource ErrorLabel}" />
                        <Button Text="{Binding OpenNotificationSettingsText}" Command="{Binding OpenNotificationSettingsCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Switch IsToggled="{Binding IsEnabled}" />
                        <Label Text="{Binding EnabledLabel}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowDetails}">
                        <HorizontalStackLayout Spacing="8">
                            <Switch IsToggled="{Binding ReadingsOn}" />
                            <Label Text="{Binding ReadingsLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8">
                            <Switch IsToggled="{Binding BillsOn}" />
                            <Label Text="{Binding BillsLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8">
                            <Switch IsToggled="{Binding VerificationOn}" />
                            <Label Text="{Binding VerificationLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8">
                            <Switch IsToggled="{Binding DraftsOn}" />
                            <Label Text="{Binding DraftsLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding TimeLabel}" Style="{StaticResource MutedLabel}" />
                        <TimePicker Time="{Binding Time}" Format="HH:mm" HorizontalOptions="Start" />
                        <Label Text="{Binding LeadDaysLabel}" Style="{StaticResource MutedLabel}" />
                        <Stepper Minimum="0" Maximum="14" Increment="1" Value="{Binding LeadDays}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                    <Button Text="{Binding SendTestText}" Command="{Binding SendTestCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                    <Button Text="{Binding PlannedText}" Command="{Binding TogglePlannedCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowPlanned}">
                        <Label Text="{Binding PlannedSummary}" Style="{StaticResource MutedLabel}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Planned}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlannedReminderRowViewModel">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="{Binding Header}" FontAttributes="Bold" />
                                        <Label Text="{Binding Text}" />
                                        <Label Text="{Binding Target}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                        <Label Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Style="{StaticResource ErrorLabel}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SectionCard}" Margin="0,12,0,0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding BackupHeader}" Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding BackupHint}" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding LastBackupText}" />
                    <Button Text="{Binding SaveBackupText}" Command="{Binding SaveBackupCommand}"
                            Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" />
                    <Button Text="{Binding RestoreBackupText}" Command="{Binding RestoreBackupCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SectionCard}" IsVisible="{Binding IsDebugBuild}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding TestDataHeader}" Style="{StaticResource SectionHeader}" />
                    <Button Text="{Binding FillSampleDataText}" Command="{Binding FillSampleDataCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                    <Button Text="{Binding DeleteAllDataText}" Command="{Binding DeleteAllDataCommand}"
                            Style="{StaticResource DestructiveButton}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorLogHeader}" FontAttributes="Bold" Margin="0,24,0,0" />
            <Label Text="{Binding ErrorLogHint}" Style="{StaticResource MutedLabel}" />
            <Grid>
            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start" AlignContent="Start">
                <Button Text="{Binding CopyLogText}" Command="{Binding CopyLogCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                <Button Text="{Binding ClearLogText}" Command="{Binding ClearLogCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
            </FlexLayout>
            </Grid>

            <Label Text="{Binding VersionText}" Margin="0,12,0,0" />
            <Label Text="{Binding DatabasePathText}" />
            <Label Text="{Binding LayoutText}" />
        </VerticalStackLayout>
    </ScrollView>

</views:PageBase>
