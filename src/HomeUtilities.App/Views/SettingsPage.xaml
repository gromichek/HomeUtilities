<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:HomeUtilities.App.Views"
                xmlns:conv="clr-namespace:HomeUtilities.App.Converters"
                xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
                x:Class="HomeUtilities.App.Views.SettingsPage"
                x:DataType="vm:SettingsViewModel"
                Title="{Binding Title}">

    <views:PageBase.ToolbarItems>
        <ToolbarItem Text="{Binding HelpText}" IconImageSource="{StaticResource IconHelpSource}" Command="{Binding OpenHelpCommand}" />
    </views:PageBase.ToolbarItems>

    <views:PageBase.Resources>
        <conv:ResourceKeyConverter x:Key="ResourceKey" />
    </views:PageBase.Resources>

    <!-- The list of sections (T-028d): one row = icon, title, current value; a row opens its page (one content pane). -->
    <CollectionView ItemsSource="{Binding Sections}" views:ListColumns.MinItemWidth="360" Margin="12">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsSectionRowViewModel">
                <Border Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                        StrokeThickness="1" Padding="12" Margin="0,4" StrokeShape="RoundRectangle 8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" FontFamily="{DynamicResource IconFontFamily}" FontSize="24" VerticalOptions="Center"
                               Text="{Binding IconKey, Converter={StaticResource ResourceKey}}"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Text="{Binding Value}" Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" FontFamily="{DynamicResource IconFontFamily}" FontSize="20" VerticalOptions="Center"
                               Text="{StaticResource IconChevron}"
                               TextColor="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</views:PageBase>
