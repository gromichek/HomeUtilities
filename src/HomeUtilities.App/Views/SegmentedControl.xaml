<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
             x:Class="HomeUtilities.App.Views.SegmentedControl">

    <!-- A segmented control (UI_GUIDELINES §3a): 2-3 short options that switch a view, one bordered group of equal columns; the selected
         segment is tinted and has a check mark — never the filled primary button style, which is reserved for the one primary action. -->
    <Border StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="0"
            Stroke="{AppThemeBinding Light={StaticResource FieldOutlineLight}, Dark={StaticResource FieldOutlineDark}}">
        <toolkit:UniformItemsLayout x:Name="Row" MaxRows="1">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:ReportOptionViewModel">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Padding="10,0" MinimumHeightRequest="{StaticResource TouchSize}"
                          HorizontalOptions="Fill" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChooseCommand}" />
                        </Grid.GestureRecognizers>
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HighlightLight}, Dark={StaticResource HighlightDark}}" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <Label Grid.Column="0" Text="{StaticResource IconCheck}" FontFamily="{DynamicResource IconFontFamily}" FontSize="18" VerticalOptions="Center"
                               IsVisible="{Binding IsSelected}"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                        <Label Grid.Column="1" Text="{Binding Text}" VerticalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </toolkit:UniformItemsLayout>
    </Border>
</ContentView>
