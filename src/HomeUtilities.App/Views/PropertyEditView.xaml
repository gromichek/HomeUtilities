<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:views="clr-namespace:HomeUtilities.App.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:HomeUtilities.Core.Common;assembly=HomeUtilities.Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
             xmlns:common="clr-namespace:HomeUtilities.ViewModels.Common;assembly=HomeUtilities.ViewModels"
             xmlns:conv="clr-namespace:HomeUtilities.App.Converters"
             x:Class="HomeUtilities.App.Views.PropertyEditView"
             x:DataType="vm:PropertyEditViewModel">

    <ContentView.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="HasText" />
        <toolkit:InvertedBoolConverter x:Key="Not" />
        <conv:HexColorConverter x:Key="HexColor" />
    </ContentView.Resources>

    <Grid>

        <ScrollView>
            <views:AdaptiveFieldGrid Padding="16" RowSpacing="16" ColumnSpacing="16" MinColumnWidth="560" MaxColumns="2">

                <!-- General -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding GeneralHeader}" Style="{StaticResource SectionHeader}" />

                        <Label Text="{Binding NameLabel}" Style="{StaticResource MutedLabel}" />
                        <Entry Text="{Binding Name}" MaxLength="{x:Static core:InputLimits.Name}" />
                        <Label Text="{Binding NameError}" Style="{StaticResource ErrorLabel}"
                               IsVisible="{Binding NameError, Converter={StaticResource HasText}}" />

                        <Label Text="{Binding KindLabel}" Style="{StaticResource MutedLabel}" />
                        <Picker ItemsSource="{Binding Kinds}"
                                ItemDisplayBinding="{Binding DisplayName, x:DataType=common:EnumOption}"
                                SelectedIndex="{Binding SelectedKindIndex, Mode=TwoWay}" />

                        <Label Text="{Binding AddressLabel}" Style="{StaticResource MutedLabel}" />
                        <Entry Text="{Binding Address}" MaxLength="{x:Static core:InputLimits.Text}" />

                        <Label Text="{Binding NotesLabel}" Style="{StaticResource MutedLabel}" />
                        <Editor Text="{Binding Notes}" MaxLength="{x:Static core:InputLimits.Notes}" AutoSize="TextChanges" MinimumHeightRequest="80" />
                        <Label Text="{Binding NotesError}" Style="{StaticResource ErrorLabel}"
                               IsVisible="{Binding NotesError, Converter={StaticResource HasText}}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Switch IsToggled="{Binding IsArchived}" />
                            <Label Grid.Column="1" Text="{Binding ArchivedLabel}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Parameters: the add button is in the card header; rows edit on tap and delete with the trash icon. -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding ParametersHeader}" Style="{StaticResource SectionHeader}" />
                            <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                    Text="{StaticResource IconAdd}" Command="{Binding AddParameterCommand}"
                                    ToolTipProperties.Text="{Binding AddParameterText}"
                                    SemanticProperties.Description="{Binding AddParameterText}" />
                        </Grid>

                        <Label Text="{Binding ParametersError}" Style="{StaticResource ErrorLabel}"
                               IsVisible="{Binding ParametersError, Converter={StaticResource HasText}}" />
                        <Label Text="{Binding ParametersEmptyText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding HasNoParameters}" />

                        <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Groups}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ParameterGroupViewModel">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                                        <Label Text="{Binding CurrentText}" Style="{StaticResource MutedLabel}" />
                                        <Button Style="{StaticResource TextButton}" Text="{Binding HistoryText}"
                                                Command="{Binding ToggleHistoryCommand}" HorizontalOptions="Start" />
                                        <VerticalStackLayout Spacing="2" IsVisible="{Binding IsExpanded}"
                                                             BindableLayout.ItemsSource="{Binding Rows}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ParameterRowViewModel">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding EditCommand}" />
                                                        </Grid.GestureRecognizers>
                                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                                            <Label Text="{Binding DisplayText}" />
                                                            <Label Text="{Binding Note}" Style="{StaticResource MutedLabel}"
                                                                   IsVisible="{Binding Note, Converter={StaticResource HasText}}" />
                                                            <Label Text="{Binding ErrorText}" Style="{StaticResource ErrorLabel}"
                                                                   IsVisible="{Binding HasError}" />
                                                        </VerticalStackLayout>
                                                        <Button Grid.Column="1" Style="{StaticResource DestructiveIconButton}"
                                                                Text="{StaticResource IconDelete}" Command="{Binding RemoveCommand}"
                                                                ToolTipProperties.Text="{Binding DeleteText}"
                                                                SemanticProperties.Description="{Binding DeleteText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Contracts: the add button is in the card header (disabled until the property is saved); rows open the contract editor. -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding ContractsHeader}" Style="{StaticResource SectionHeader}" />
                            <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                    Text="{StaticResource IconAdd}" Command="{Binding AddContractCommand}"
                                    ToolTipProperties.Text="{Binding AddContractText}"
                                    SemanticProperties.Description="{Binding AddContractText}" />
                        </Grid>

                        <Label Text="{Binding ContractsSaveFirstText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding ShowContractsSaveFirst}" />
                        <Label Text="{Binding ContractsEmptyText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding HasNoContracts}" />

                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding ContractRows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ContractRowViewModel">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                        </Grid.GestureRecognizers>
                                        <Border Grid.Column="0" WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0" VerticalOptions="Center"
                                                BackgroundColor="{Binding Color, Converter={StaticResource HexColor}}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                                            <Label Text="{Binding SubtitleText}" Style="{StaticResource MutedLabel}" />
                                            <Label Text="{Binding EndedText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding IsEnded}" />
                                            <Label Text="{Binding ArchivedText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding IsArchived}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Switch IsToggled="{Binding ShowEndedContracts}" />
                            <Label Grid.Column="1" Text="{Binding ShowEndedContractsText}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Meters: grouped by resource; the add button is in the card header (disabled until the property is saved). -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding MetersHeader}" Style="{StaticResource SectionHeader}" />
                            <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                    Text="{StaticResource IconAdd}" Command="{Binding AddMeterCommand}"
                                    ToolTipProperties.Text="{Binding AddMeterText}"
                                    SemanticProperties.Description="{Binding AddMeterText}" />
                        </Grid>

                        <Label Text="{Binding ContractsSaveFirstText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding ShowContractsSaveFirst}" />
                        <Label Text="{Binding MetersEmptyText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding HasNoMeters}" />

                        <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding MeterGroups}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:MeterGroupViewModel">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="{Binding Header}" Style="{StaticResource MutedLabel}" FontAttributes="Bold" />
                                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Rows}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MeterRowViewModel">
                                                    <VerticalStackLayout Spacing="2">
                                                        <VerticalStackLayout.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                                        </VerticalStackLayout.GestureRecognizers>
                                                        <VerticalStackLayout.Triggers>
                                                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsRemoved}" Value="True">
                                                                <Setter Property="Opacity" Value="0.6" />
                                                            </DataTrigger>
                                                        </VerticalStackLayout.Triggers>
                                                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                                                        <Label Text="{Binding SerialText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding HasSerial}" />
                                                        <Label Text="{Binding RegistersText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding HasRegisters}" />
                                                        <Label Text="{Binding RemovedText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding IsRemoved}" />
                                                        <Label Text="{Binding BadgeText}" Style="{StaticResource BadgeOverdueLabel}" IsVisible="{Binding IsOverdue}" />
                                                        <Label Text="{Binding BadgeText}" Style="{StaticResource BadgeDueSoonLabel}" IsVisible="{Binding IsDueSoon}" />
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Switch IsToggled="{Binding ShowRemovedMeters}" />
                            <Label Grid.Column="1" Text="{Binding ShowRemovedMetersText}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Destructive action at the end of the form. -->
                <Button Text="{Binding DeleteWholeText}" Command="{Binding DeleteCommand}"
                        Style="{StaticResource DestructiveButton}" HorizontalOptions="Start"
                        IsVisible="{Binding ShowFormDelete}" />
            </views:AdaptiveFieldGrid>
        </ScrollView>

    </Grid>
</ContentView>
