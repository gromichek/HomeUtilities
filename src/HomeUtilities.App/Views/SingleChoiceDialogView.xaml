<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:HomeUtilities.App.Views"
             xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
             x:Class="HomeUtilities.App.Views.SingleChoiceDialogView"
             x:DataType="vm:SingleChoiceDialogViewModel"
             VerticalOptions="Fill"
             BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">

    <!-- Title on top, scrolling radio list, Cancel / OK bottom right (UI_GUIDELINES §3a). -->
    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="8">
        <Label Grid.Row="0" Text="{Binding Title}" Style="{StaticResource SectionHeader}" VerticalOptions="Start" />

        <ScrollView Grid.Row="1" VerticalOptions="Start">
            <views:RadioChoiceList Items="{Binding Items}" />
        </ScrollView>

        <HorizontalStackLayout Grid.Row="2" Spacing="8" HorizontalOptions="End" Margin="0,12,0,0">
            <Button Text="{Binding CancelText}" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Text="{Binding OkText}" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" />
        </HorizontalStackLayout>
    </Grid>
</ContentView>
