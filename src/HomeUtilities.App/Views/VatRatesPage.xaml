<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:HomeUtilities.App.Views"
                xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
                x:Class="HomeUtilities.App.Views.VatRatesPage"
                x:DataType="vm:VatRatesViewModel"
                Title="{Binding Title}">

    <views:PageBase.ToolbarItems>
        <ToolbarItem Text="{Binding HelpText}" IconImageSource="{StaticResource IconHelpSource}" Command="{Binding OpenHelpCommand}" />
    </views:PageBase.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">
        <Button Grid.Row="0" Text="{Binding AddText}" Command="{Binding AddCommand}"
                ImageSource="{StaticResource IconAddSource}" ContentLayout="Left,8"
                HorizontalOptions="Start" IsVisible="{Binding ShowAddButton}" />

        <!-- The defaults were entered from memory: the owner is asked to verify them. -->
        <Label Grid.Row="1" Text="{Binding BannerText}" Style="{StaticResource MutedLabel}" />

        <CollectionView x:Name="ItemList" Grid.Row="2" ItemsSource="{Binding Items}" views:ListColumns.MinItemWidth="360" IsVisible="{Binding HasItems}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:VatRateItemViewModel">
                    <Border Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" StrokeThickness="1" Padding="12" Margin="0,4" StrokeShape="RoundRectangle 8">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" x:DataType="vm:VatRateItemViewModel" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Code}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding PercentText}" VerticalOptions="Center" FontAttributes="Bold" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="16" VerticalOptions="Center" HorizontalOptions="Center"
                             IsVisible="{Binding IsEmpty}">
            <Label Text="{Binding EmptyText}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Phone layout: floating add button, bottom-right. -->
        <Button Grid.Row="0" Grid.RowSpan="3" Style="{StaticResource FabButton}"
                Text="{StaticResource IconAdd}" Command="{Binding AddCommand}"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,4,16"
                IsVisible="{Binding ShowAddFab}"
                ToolTipProperties.Text="{Binding AddText}"
                SemanticProperties.Description="{Binding AddText}" />
    </Grid>


</views:PageBase>
