<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
             x:Class="HomeUtilities.App.Views.ImportColumnPickerView"
             x:DataType="vm:ImportColumnPickerViewModel">

    <!-- One target field of the import and the sheet column that feeds it. -->
    <VerticalStackLayout Spacing="2">
        <Label Text="{Binding Label}" Style="{StaticResource MutedLabel}" FontSize="12" />
        <Picker ItemsSource="{Binding Options}"
                ItemDisplayBinding="{Binding Text, x:DataType=vm:ImportColumnOption}"
                SelectedItem="{Binding Selected}" />
    </VerticalStackLayout>

</ContentView>
