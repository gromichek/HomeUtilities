<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:common="clr-namespace:HomeUtilities.ViewModels.Common;assembly=HomeUtilities.ViewModels"
             x:Class="HomeUtilities.App.Views.DialogFrame"
             x:DataType="common:EditorDialogViewModel">

    <!-- The frame of every dialog on the phone (UI_GUIDELINES §3.4, R-29): a top bar in the toolbar colour with ← (Cancel), the title
         and ✓ (the dialog's primary action), and the dialog's own content below it. The bar stays put while the content scrolls
         and while the keyboard is open, so the primary action is never hidden by the keyboard; the status bar above it has the
         same colour (C-04). -->
    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4" Padding="4,0,4,0" MinimumHeightRequest="56"
              BackgroundColor="{AppThemeBinding Light={StaticResource ToolbarLight}, Dark={StaticResource ToolbarDark}}">
            <Button Grid.Column="0" Style="{StaticResource IconButton}" Text="{StaticResource IconBack}" FontSize="24"
                    TextColor="{AppThemeBinding Light={StaticResource OnToolbarLight}, Dark={StaticResource OnToolbarDark}}"
                    Command="{Binding CancelCommand}"
                    ToolTipProperties.Text="{Binding CancelText}"
                    SemanticProperties.Description="{Binding CancelText}" />
            <Label Grid.Column="1" Text="{Binding Title}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" MaxLines="2"
                   LineBreakMode="TailTruncation"
                   TextColor="{AppThemeBinding Light={StaticResource OnToolbarLight}, Dark={StaticResource OnToolbarDark}}" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Text="{StaticResource IconSave}" FontSize="24"
                    TextColor="{AppThemeBinding Light={StaticResource OnToolbarLight}, Dark={StaticResource OnToolbarDark}}"
                    Command="{Binding PrimaryCommand}" IsVisible="{Binding ShowPrimary}"
                    ToolTipProperties.Text="{Binding SaveText}"
                    SemanticProperties.Description="{Binding SaveText}" />
        </Grid>
        <ContentView x:Name="Body" Grid.Row="1" />
    </Grid>
</ContentView>
