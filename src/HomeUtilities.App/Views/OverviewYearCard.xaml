<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
             x:Class="HomeUtilities.App.Views.OverviewYearCard"
             x:DataType="vm:OverviewViewModel">

    <!-- This year: one block per property, one tappable line per figure. -->
    <Border Style="{StaticResource SectionCard}">
        <VerticalStackLayout Spacing="8">
            <Label Text="{Binding YearHeader}" Style="{StaticResource SectionHeader}" />

            <Label Text="{Binding YearEmptyText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding ShowYearEmpty}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding YearBlocks}" Spacing="10" IsVisible="{Binding HasYear}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:OverviewBlockViewModel">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Header}" FontAttributes="Bold" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OverviewLineViewModel">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="36">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                            </Grid.GestureRecognizers>
                                            <Label Grid.Column="0" Text="{Binding Text}" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" x:DataType="vm:OverviewLineViewModel" Binding="{Binding IsDebt}" Value="True">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" x:DataType="vm:OverviewLineViewModel" Binding="{Binding IsGood}" Value="True">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Grid.Column="1" Text="{StaticResource IconChevron}" FontFamily="{DynamicResource IconFontFamily}"
                                                   VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
