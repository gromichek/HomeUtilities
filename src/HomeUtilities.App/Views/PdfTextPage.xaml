<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:HomeUtilities.App.Views"
                xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
                x:Class="HomeUtilities.App.Views.PdfTextPage"
                x:DataType="vm:PdfTextViewModel"
                Title="{Binding Title}">

    <views:PageBase.ToolbarItems>
        <ToolbarItem Text="{Binding HelpText}" IconImageSource="{StaticResource IconHelpToolbarSource}" Command="{Binding OpenHelpCommand}" />
    </views:PageBase.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12">
            <Label Text="{Binding HintText}" Style="{StaticResource MutedLabel}" FontSize="13" />
            <Button Text="{Binding CopyText}" Command="{Binding CopyCommand}"
                    Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" views:CompactFill.Enabled="True" />
            <!-- Read-only and selectable; the lines keep their columns in a fixed-width font. -->
            <Editor Text="{Binding Text}" IsReadOnly="True" AutoSize="TextChanges" FontSize="12">
                <Editor.FontFamily>
                    <OnPlatform x:TypeArguments="x:String">
                        <On Platform="WinUI" Value="Consolas" />
                        <On Platform="Android" Value="monospace" />
                    </OnPlatform>
                </Editor.FontFamily>
            </Editor>
        </VerticalStackLayout>
    </ScrollView>
</views:PageBase>
