<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:HomeUtilities.App.Views"
                xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
                x:Class="HomeUtilities.App.Views.PropertyEditPage"
                x:DataType="vm:PropertyEditViewModel"
                Title="{Binding Title}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding CancelCommand}" />
    </Shell.BackButtonBehavior>

    <views:PageBase.ToolbarItems>
        <ToolbarItem Text="{Binding SaveText}" Command="{Binding SaveCommand}" />
        <ToolbarItem Text="{Binding CancelText}" Command="{Binding CancelCommand}" />
    </views:PageBase.ToolbarItems>

    <views:PropertyEditView />

</views:PageBase>
