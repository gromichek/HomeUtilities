<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
             x:Class="HomeUtilities.App.Views.SnackbarHost"
             x:DataType="vm:SnackbarService"
             IsVisible="False"
             HorizontalOptions="Center"
             VerticalOptions="End"
             Margin="16,0,16,88">

    <!-- Non-modal bar at the bottom of the window (above the floating add button); the message is announced to screen readers by the code-behind. -->
    <!-- The bar is at least 56 dp high on Android and the action takes the whole right part of it (at least 48 x 48 dp, usually
         much wider), so Undo is easy to hit (owner 2026-11-05). -->
    <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="16,0,0,0" MinimumHeightRequest="{StaticResource SnackbarMinHeight}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SnackbarBackgroundLight}, Dark={StaticResource SnackbarBackgroundDark}}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding DismissCommand}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Grid.Column="0" Text="{Binding Message}" VerticalOptions="Center" Margin="0,8"
                   TextColor="{AppThemeBinding Light={StaticResource SnackbarTextLight}, Dark={StaticResource SnackbarTextDark}}"
                   SemanticProperties.Description="{Binding Message}" />
            <Button Grid.Column="1" Text="{Binding ActionText}" Command="{Binding InvokeActionCommand}"
                    IsVisible="{Binding HasAction}" Style="{StaticResource TextButton}" FontAttributes="Bold"
                    VerticalOptions="Fill" Padding="20,0" MinimumWidthRequest="{StaticResource TouchSize}"
                    MinimumHeightRequest="{StaticResource SnackbarMinHeight}"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource PrimaryLight}}"
                    SemanticProperties.Description="{Binding ActionText}" />
        </Grid>
    </Border>

</ContentView>
