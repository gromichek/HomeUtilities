<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
             x:Class="HomeUtilities.App.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="30,0" Spacing="25" VerticalOptions="Center">
        <Label Text="{Binding Title}"
               FontSize="32"
               HorizontalOptions="Center" />
        <Label Text="{Binding TodayText}"
               HorizontalOptions="Center" />
        <Label Text="{Binding Hint}"
               HorizontalOptions="Center" />
        <Label Text="{Binding DatabaseStatusText}"
               HorizontalOptions="Center" />
        <Button Text="{Binding SwitchLanguageText}"
                Command="{Binding ToggleLanguageCommand}"
                HorizontalOptions="Center" />
    </VerticalStackLayout>

</ContentPage>
