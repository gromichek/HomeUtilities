<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:HomeUtilities.App.Views"
                xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
                x:Class="HomeUtilities.App.Views.PropertiesPage"
                x:DataType="vm:PropertiesViewModel"
                Title="{Binding Title}">

    <views:PageBase.ToolbarItems>
        <ToolbarItem Text="{Binding AddText}" Command="{Binding AddCommand}" />
    </views:PageBase.ToolbarItems>

    <Grid x:Name="Root" ColumnDefinitions="*,0">

        <Grid Grid.Column="0" RowDefinitions="Auto,*" Padding="12">
            <HorizontalStackLayout Grid.Row="0" Spacing="8">
                <Switch IsToggled="{Binding ShowArchived}" />
                <Label Text="{Binding ShowArchivedText}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PropertyItemViewModel">
                        <Border Padding="12" Margin="0,4" StrokeShape="RoundRectangle 8">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" x:DataType="vm:PropertyItemViewModel" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding KindText}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding Address}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding SummaryText}" />
                                <Label Text="{Binding ArchivedText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding IsArchived}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout Grid.Row="1" Spacing="16" VerticalOptions="Center" HorizontalOptions="Center"
                                 IsVisible="{Binding IsEmpty}">
                <Label Text="{Binding EmptyText}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                <Button Text="{Binding AddText}" Command="{Binding AddCommand}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Column="1">
            <views:PropertyEditView BindingContext="{Binding SelectedProperty}" IsVisible="{Binding HasSelection}" />
            <Label Text="{Binding SelectHintText}" Style="{StaticResource MutedLabel}"
                   HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding ShowSelectHint}" />
        </Grid>
    </Grid>

</views:PageBase>
