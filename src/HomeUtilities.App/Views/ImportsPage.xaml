<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:core="clr-namespace:HomeUtilities.Core.Common;assembly=HomeUtilities.Core"
                xmlns:views="clr-namespace:HomeUtilities.App.Views"
                xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
                x:Class="HomeUtilities.App.Views.ImportsPage"
                x:DataType="vm:ImportsViewModel"
                Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12">

            <Button Text="{Binding StartImportText}" Command="{Binding StartImportCommand}"
                    Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" />

            <!-- The reverse of the import: the data as a workbook like the owner's own. -->
            <VerticalStackLayout Spacing="4">
                <Button Text="{Binding ExportExcelText}" Command="{Binding ExportExcelCommand}"
                        Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                <Label Text="{Binding ExportExcelHint}" Style="{StaticResource MutedLabel}" FontSize="13" />
            </VerticalStackLayout>

            <!-- Finished imports; each can be undone as a whole. -->
            <Border Style="{StaticResource SectionCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding BatchesHeader}" Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding BatchesEmpty}" Style="{StaticResource MutedLabel}" IsVisible="{Binding HasNoBatches}" />
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding BatchItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImportBatchItemViewModel">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding TitleText}" FontAttributes="Bold" />
                                        <Label Text="{Binding DetailText}" Style="{StaticResource MutedLabel}" FontSize="13" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="{Binding UndoText}" Command="{Binding UndoCommand}"
                                            Style="{StaticResource DestructiveButton}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Saved profiles: rename, export (no amounts or readings inside), delete. -->
            <Border Style="{StaticResource SectionCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ProfilesHeader}" Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding ProfilesHint}" Style="{StaticResource MutedLabel}" FontSize="13" />
                    <Label Text="{Binding ProfilesEmpty}" Style="{StaticResource MutedLabel}" IsVisible="{Binding HasNoProfiles}" />
                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding ProfileItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImportProfileItemViewModel">
                                <VerticalStackLayout Spacing="4">
                                    <Entry Text="{Binding Name}" MaxLength="{x:Static core:InputLimits.Name}" />
                                    <Label Text="{Binding SheetText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="{Binding SaveText}" Command="{Binding SaveCommand}"
                                                Style="{StaticResource SecondaryButton}" IsVisible="{Binding IsChanged}" />
                                        <Button Text="{Binding ExportText}" Command="{Binding ExportCommand}"
                                                Style="{StaticResource SecondaryButton}" />
                                        <Button Text="{Binding DeleteText}" Command="{Binding DeleteCommand}"
                                                Style="{StaticResource DestructiveButton}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="{Binding ImportProfileText}" Command="{Binding ImportProfileCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- Repair: links that start after the meter was installed hide the earlier readings. -->
            <Border Style="{StaticResource SectionCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding LinkRepairHeader}" Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding LinkRepairHint}" Style="{StaticResource MutedLabel}" FontSize="13" />
                    <Label Text="{Binding LinkRepairNone}" Style="{StaticResource MutedLabel}" IsVisible="{Binding HasNoLinkRepair}" />
                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding LinkRepairLines}" IsVisible="{Binding HasLinkRepair}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="{Binding LinkRepairButtonText}" Command="{Binding RepairLinksCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" IsVisible="{Binding HasLinkRepair}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="True" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>

</views:PageBase>
