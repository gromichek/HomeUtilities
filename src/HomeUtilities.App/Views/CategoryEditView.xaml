<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:views="clr-namespace:HomeUtilities.App.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:HomeUtilities.Core.Common;assembly=HomeUtilities.Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:conv="clr-namespace:HomeUtilities.App.Converters"
             xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
             x:Class="HomeUtilities.App.Views.CategoryEditView"
             x:DataType="vm:CategoryEditViewModel">

    <ContentView.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="HasText" />
        <conv:HexColorConverter x:Key="HexColor" />
    </ContentView.Resources>

    <Grid>

        <ScrollView>
            <views:AdaptiveFieldGrid Padding="16" RowSpacing="16" ColumnSpacing="16" MinColumnWidth="560" MaxColumns="2">

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding GeneralHeader}" Style="{StaticResource SectionHeader}" />

                        <Label Text="{Binding NameLabel}" Style="{StaticResource MutedLabel}" />
                        <Entry Text="{Binding Name}" MaxLength="{x:Static core:InputLimits.Name}" />
                        <Label Text="{Binding NameHint}" Style="{StaticResource MutedLabel}" FontSize="12"
                               IsVisible="{Binding HasNameHint}" />
                        <Label Text="{Binding NameError}" Style="{StaticResource ErrorLabel}"
                               IsVisible="{Binding NameError, Converter={StaticResource HasText}}" />

                        <Label Text="{Binding ColorLabel}" Style="{StaticResource MutedLabel}" />
                        <!-- Two fixed rows of 6 (6 x 36 + 5 x 8 = 256 dp) instead of FlexLayout, which clips the first
                             item of each row on Android (owner screenshot 2026-10-23). -->
                        <VerticalStackLayout Spacing="8" Padding="2">
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding SwatchesRow1}">
                                <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColorSwatchViewModel">
                                    <Border WidthRequest="36" HeightRequest="36"
                                            StrokeShape="RoundRectangle 18" StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                                            BackgroundColor="{Binding Color, Converter={StaticResource HexColor}}"
                                            SemanticProperties.Description="{Binding Color}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" x:DataType="vm:ColorSwatchViewModel" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                                <Setter Property="StrokeThickness" Value="4" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding SwatchesRow2}">
                                <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColorSwatchViewModel">
                                    <Border WidthRequest="36" HeightRequest="36"
                                            StrokeShape="RoundRectangle 18" StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                                            BackgroundColor="{Binding Color, Converter={StaticResource HexColor}}"
                                            SemanticProperties.Description="{Binding Color}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" x:DataType="vm:ColorSwatchViewModel" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                                <Setter Property="StrokeThickness" Value="4" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Label Text="{Binding ColorHexLabel}" Style="{StaticResource MutedLabel}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0" Text="{Binding Color}" MaxLength="{x:Static core:InputLimits.Color}" />
                            <Border Grid.Column="1" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                                    StrokeThickness="1" VerticalOptions="Center"
                                    Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                                    BackgroundColor="{Binding Color, Converter={StaticResource HexColor}}" />
                        </Grid>
                        <Label Text="{Binding ColorError}" Style="{StaticResource ErrorLabel}"
                               IsVisible="{Binding ColorError, Converter={StaticResource HasText}}" />

                        <Label Text="{Binding NotesLabel}" Style="{StaticResource MutedLabel}" />
                        <Editor Text="{Binding Notes}" MaxLength="{x:Static core:InputLimits.Notes}" AutoSize="TextChanges" MinimumHeightRequest="80" />
                        <Label Text="{Binding NotesError}" Style="{StaticResource ErrorLabel}"
                               IsVisible="{Binding NotesError, Converter={StaticResource HasText}}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Switch IsToggled="{Binding IsArchived}" />
                            <Label Grid.Column="1" Text="{Binding ArchivedLabel}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Destructive action at the end of the form (user categories only). -->
                <Button Text="{Binding DeleteWholeText}" Command="{Binding DeleteCommand}"
                        Style="{StaticResource DestructiveButton}" HorizontalOptions="Start"
                        IsVisible="{Binding ShowFormDelete}" />
            </views:AdaptiveFieldGrid>
        </ScrollView>

    </Grid>
</ContentView>
