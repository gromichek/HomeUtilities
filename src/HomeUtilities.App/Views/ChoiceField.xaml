<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:HomeUtilities.App.Views"
             x:Class="HomeUtilities.App.Views.ChoiceField">

    <!-- The one "pick one of a list" field (UI_GUIDELINES §3a): caption above, the current value in a bordered box with a chevron;
         a tap opens the choice dialog. The value wraps to two lines. -->
    <VerticalStackLayout x:Name="Field" Spacing="2" x:DataType="views:ChoiceField">
        <Label Text="{Binding Caption}" Style="{StaticResource MutedLabel}" IsVisible="{Binding HasCaption}" />
        <Border Stroke="{AppThemeBinding Light={StaticResource FieldOutlineLight}, Dark={StaticResource FieldOutlineDark}}"
                StrokeThickness="1" Padding="12,0" StrokeShape="RoundRectangle 8"
                MinimumHeightRequest="{StaticResource TouchSize}"
                SemanticProperties.Description="{Binding AccessibleName}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTapped" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{Binding DisplayText}" LineBreakMode="WordWrap" MaxLines="2" VerticalOptions="Center" Margin="0,10" />
                <Label Grid.Column="1" Text="{StaticResource IconExpand}" FontFamily="{DynamicResource IconFontFamily}" FontSize="20" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
