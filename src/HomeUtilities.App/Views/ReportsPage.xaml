<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:HomeUtilities.App.Views"
                xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
                x:Class="HomeUtilities.App.Views.ReportsPage"
                x:DataType="vm:ReportsViewModel"
                Title="{Binding Title}">

    <!-- Help, and the exports in the overflow ("⋯") menu: they are rare, the table needs the room. -->
    <views:PageBase.ToolbarItems>
        <ToolbarItem Text="{Binding ExportExcelText}" Order="Secondary" Command="{Binding ExportExcelCommand}" />
        <ToolbarItem Text="{Binding ExportCsvText}" Order="Secondary" Command="{Binding ExportCsvCommand}" />
        <ToolbarItem Text="{Binding HelpText}" IconImageSource="{StaticResource IconHelpSource}" Command="{Binding OpenHelpCommand}" />
    </views:PageBase.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12">

            <!-- Which report -->
            <views:ReportOptionRow Items="{Binding Kinds}" />

            <!-- Filters: fields that open pickers; one summary line when collapsed. -->
            <Border Style="{StaticResource SectionCard}" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" VerticalOptions="Center" Text="{Binding FiltersTitle}" Style="{StaticResource SectionHeader}"
                               IsVisible="{Binding FiltersExpanded}" />
                        <Label Grid.Column="0" VerticalOptions="Center" Text="{Binding SummaryText}" LineBreakMode="TailTruncation" MaxLines="2"
                               IsVisible="{Binding ShowFilterSummary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleFiltersCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Text="{StaticResource IconCollapse}"
                                Command="{Binding ToggleFiltersCommand}" IsVisible="{Binding FiltersExpanded}"
                                ToolTipProperties.Text="{Binding FiltersToggleText}"
                                SemanticProperties.Description="{Binding FiltersToggleText}" />
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Text="{StaticResource IconExpand}"
                                Command="{Binding ToggleFiltersCommand}" IsVisible="{Binding ShowFilterSummary}"
                                ToolTipProperties.Text="{Binding FiltersToggleText}"
                                SemanticProperties.Description="{Binding FiltersToggleText}" />
                    </Grid>

                    <views:AdaptiveFieldGrid Columns="{Binding FilterColumns}" IsVisible="{Binding FiltersExpanded}">
                        <views:ReportFilterField Caption="{Binding PeriodLabel}" Value="{Binding PeriodFieldText}" Command="{Binding ChoosePeriodCommand}" />
                        <views:ReportFilterField Caption="{Binding PropertiesLabel}" Value="{Binding PropertiesFieldText}" Command="{Binding ChoosePropertiesCommand}" />
                        <views:ReportFilterField Caption="{Binding CategoriesLabel}" Value="{Binding CategoriesFieldText}" Command="{Binding ChooseCategoriesCommand}"
                                                 IsVisible="{Binding ShowCategories}" />

                        <VerticalStackLayout Spacing="2" IsVisible="{Binding ShowGrouping}">
                            <Label Text="{Binding GroupingLabel}" Style="{StaticResource MutedLabel}" />
                            <Picker ItemsSource="{Binding Groupings}" ItemDisplayBinding="{Binding Text, x:DataType=vm:ReportOptionViewModel}"
                                    SelectedIndex="{Binding GroupingIndex, Mode=TwoWay}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2" IsVisible="{Binding ShowMeasure}">
                            <Label Text="{Binding MeasureLabel}" Style="{StaticResource MutedLabel}" />
                            <Picker ItemsSource="{Binding Measures}" ItemDisplayBinding="{Binding Text, x:DataType=vm:ReportOptionViewModel}"
                                    SelectedIndex="{Binding MeasureIndex, Mode=TwoWay}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2" IsVisible="{Binding ShowRowModes}">
                            <Label Text="{Binding RowsLabel}" Style="{StaticResource MutedLabel}" />
                            <Picker ItemsSource="{Binding RowModes}" ItemDisplayBinding="{Binding Text, x:DataType=vm:ReportOptionViewModel}"
                                    SelectedIndex="{Binding RowModeIndex, Mode=TwoWay}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowYearOverYear}">
                            <Label Grid.Column="0" Text="{Binding YearOverYearText}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding YearOverYear}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowPerMeter}">
                            <Label Grid.Column="0" Text="{Binding PerMeterText}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding PerMeter}" />
                        </Grid>
                    </views:AdaptiveFieldGrid>
                </VerticalStackLayout>
            </Border>

            <!-- Always running when visible: toggling IsRunning as well left the Android spinner turning after the first load. -->
            <ActivityIndicator IsRunning="True" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

            <Label Text="{Binding EmptyText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding ShowEmpty}" />

            <!-- Table / Chart switch (narrow screens; wide screens show the chart above the table). -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowViewSwitch}">
                <Label Text="{Binding ViewLabel}" Style="{StaticResource MutedLabel}" />
                <views:ReportOptionRow Items="{Binding ViewModes}" />
            </VerticalStackLayout>

            <views:ReportChartsView Charts="{Binding Charts}" Hint="{Binding ChartHintText}" IsVisible="{Binding ShowChart}" />

            <views:ReportTableView Table="{Binding TableView}" IsVisible="{Binding ShowTable}" />

            <Label Text="{Binding LegendText}" Style="{StaticResource MutedLabel}" FontSize="12" IsVisible="{Binding ShowLegend}" />
        </VerticalStackLayout>
    </ScrollView>
</views:PageBase>
