<?xml version="1.0" encoding="utf-8" ?>
<views:EditorPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:views="clr-namespace:HomeUtilities.App.Views"
                      xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
                      x:Class="HomeUtilities.App.Views.BillTemplateEditPage"
                      x:DataType="vm:BillTemplateEditViewModel"
                      Title="{Binding Title}">

    <views:EditorPageBase.ToolbarItems>
        <ToolbarItem Text="{Binding HelpText}" IconImageSource="{StaticResource IconHelpSource}" Command="{Binding OpenHelpCommand}" />
        <ToolbarItem Text="{Binding SaveText}" IconImageSource="{StaticResource IconSaveSource}" Command="{Binding SaveCommand}" />
    </views:EditorPageBase.ToolbarItems>

    <views:BillTemplateEditView />

</views:EditorPageBase>
