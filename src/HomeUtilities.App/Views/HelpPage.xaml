<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:HomeUtilities.App.Views"
                xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
                x:Class="HomeUtilities.App.Views.HelpPage"
                x:DataType="vm:HelpViewModel"
                Title="{Binding Title}">

    <!-- Logic lives in HelpViewModel; the WebView only shows the rendered HTML (set in code-behind: a source is not a
         visual child, so a binding on HtmlWebViewSource is unreliable). -->
    <WebView x:Name="Browser" Navigating="OnNavigating" />

</views:PageBase>
