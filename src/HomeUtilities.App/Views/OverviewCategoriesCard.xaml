<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:HomeUtilities.App.Converters"
             xmlns:views="clr-namespace:HomeUtilities.App.Views"
             xmlns:vm="clr-namespace:HomeUtilities.ViewModels;assembly=HomeUtilities.ViewModels"
             x:Class="HomeUtilities.App.Views.OverviewCategoriesCard"
             x:DataType="vm:OverviewViewModel">

    <ContentView.Resources>
        <conv:HexColorConverter x:Key="HexColor" />
    </ContentView.Resources>

    <!-- Spending of this year by category: one stacked bar in the category colours and a tappable row per category. -->
    <Border Style="{StaticResource SectionCard}">
        <VerticalStackLayout Spacing="8">
            <Label Text="{Binding CategoriesHeader}" Style="{StaticResource SectionHeader}" />

            <Label Text="{Binding CategoriesEmptyText}" Style="{StaticResource MutedLabel}" IsVisible="{Binding ShowCategoriesEmpty}" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasCategories}">
                <Label Text="{Binding CategoriesSubtitle}" Style="{StaticResource MutedLabel}" />
                <views:ShareBar Segments="{Binding CategorySegments}" SemanticProperties.Description="{Binding CategoriesSummary}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding CategoryRows}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" MinimumHeightRequest="48"
                                  SemanticProperties.Description="{Binding Description}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                </Grid.GestureRecognizers>
                                <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" CornerRadius="3" VerticalOptions="Center"
                                         Color="{Binding Color, Converter={StaticResource HexColor}}" />
                                <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding AmountText}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                <Label Grid.Column="3" Text="{Binding ShareText}" Style="{StaticResource MutedLabel}" VerticalOptions="Center"
                                       HorizontalTextAlignment="End" MinimumWidthRequest="40" IsVisible="{Binding HasShare}" />
                                <Label Grid.Column="4" Text="{StaticResource IconChevron}" FontFamily="{DynamicResource IconFontFamily}"
                                       VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
